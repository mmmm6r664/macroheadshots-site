{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://www.instagram.com https://www.statcounter.com https://secure.statcounter.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://www.instagram.com https://*.statcounter.com https://formsubmit.co; frame-src https://www.instagram.com; media-src 'self' https:; object-src 'none'; base-uri 'self'; form-action 'self' https://formsubmit.co; frame-ancestors 'none'; upgrade-insecure-requests"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "X-DNS-Prefetch-Control",
          "value": "on"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(css|js)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/gallery",
      "destination": "/portfolio",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/headshots-in-:town/",
      "destination": "/headshots-in-:town"
    },
    {
      "source": "/corporate-headshots/",
      "destination": "/corporate-headshots"
    },
    {
      "source": "/linkedin-headshots/",
      "destination": "/linkedin-headshots"
    },
    {
      "source": "/acting-headshots/",
      "destination": "/acting-headshots"
    },
    {
      "source": "/residency-headshots/",
      "destination": "/residency-headshots"
    },
    {
      "source": "/professional-headshots/",
      "destination": "/professional-headshots"
    },
    {
      "source": "/executive-headshots/",
      "destination": "/executive-headshots"
    },
    {
      "source": "/team-headshots/",
      "destination": "/team-headshots"
    },
    {
      "source": "/headshot-retouching/",
      "destination": "/headshot-retouching"
    }
  ]
}